# AYUSH SkillConnect Environment Variables Template
# Copy this file to .env.local and populate with your credentials.

# Supabase Public Configuration (Safe for client-side / browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Secret (Server-side ONLY - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
